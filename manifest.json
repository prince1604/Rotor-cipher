{
  "manifest_version": 3,
  "name": "Rotor",
  "version": "1.0.0",
  "description": "Local cipher workbench. Encode, hash, encrypt, generate — nothing leaves this machine.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "action": {
    "default_title": "Rotor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "html/panel.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
